# "respeaker" to enable DOA, or any other name (e.g. "default") to just stream audio
MIC_DEVICE=respeaker
# Number of mic channels, not allowed to more than mic can handle
# We need all 6 channels of the respeaker, to use AEC
MIC_CHANNELS=6                  
# Gemini likes 16 kHz
MIC_RATE=16000
# ch0 for AEC
MIC_PROCESSED_CHANNEL=0
# Seconds to keep dropping mic audio after pib stops speaking (voice_assistant
# audio_loop.py). This ReSpeaker (UAC1.0) has NO working hardware echo
# cancellation and USB clock drift makes software AEC ineffective, so without
# this the mic re-transcribes pib's own TTS: Gemini thinks the user is
# interrupting (self-interruption, doubled/garbled transcripts, and the chat
# UI spawns a fresh bubble per spurious role switch). The stock 0.6s is too
# short - the tail of pib's speech still leaks in. 1.3s reliably suppresses
# self-hearing; the trade-off is no barge-in (user can't interrupt pib
# mid-sentence) and pib listens ~0.7s later. Tune here if needed.
MIC_MUTE_TRAIL_S=1.3
